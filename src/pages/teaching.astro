---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import PasswordGate from '../components/PasswordGate.astro';
---

<BaseLayout title="Teaching — Robert Westwood">
	<PageTitle>Teaching</PageTitle>
	<PasswordGate>
		<section class="teaching container">
			<p class="copy intro">
				Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt
				ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco
				laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in
				voluptate velit esse cillum dolore eu fugiat nulla pariatur.
			</p>
		</section>
	</PasswordGate>
</BaseLayout>

<style>
	.teaching {
		padding-bottom: var(--space-section);
	}
	/* Copy: body text style, matching the Approach page */
	.copy {
		font-size: 1.125rem;
		font-weight: 300;
		line-height: var(--leading-normal);
	}
	.intro {
		max-width: 48rem;
	}
</style>
