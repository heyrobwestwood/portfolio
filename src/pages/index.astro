---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<section class="intro container" id="about">
		<h1><span class="line lead">Experience design architect, AI builder, and team leader. </span><span class="line soft">Transforming complex systems into intuitive, human-centered experiences. </span><span class="line soft last">Dedicated to building and mentoring high-velocity design teams.</span></h1>
		<p class="contact" id="contact">
			<a class="email" href="mailto:heyrobwestwood@gmail.com">heyrobwestwood@gmail.com</a>
			<button type="button" class="copy" data-email="heyrobwestwood@gmail.com" aria-label="Copy email address" title="Copy email address">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="9" y="9" width="13" height="13" rx="2" />
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
				</svg>
			</button>
		</p>
	</section>
</BaseLayout>

<style>
	.intro {
		width: 75%;
		padding-block: var(--space-section);
	}

	.intro h1 {
		width: 90%;
		max-width: none;
		margin-block: var(--space-4) var(--space-6);
		font-size: 3.5rem;
	}

	/* Each sentence's own text is painted from a two-tone gradient: amber on the left, its resting color on the right.
	   Sliding the gradient recolors the existing text left to right on hover and back on mouse-off.
	   The sweep is linear, and --sweep (set per sentence by the script below) scales its duration to the sentence length so every sentence moves at the same speed. */
	.line {
		background-image: linear-gradient(to right, #e09f2f 50%, var(--rest) 50%);
		background-size: 200% 100%;
		background-position: 100% 0;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
		transition: background-position var(--sweep, 0.4s) linear, opacity 0.4s ease;
	}

	.line:hover {
		background-position: 0 0;
	}

	/* Resting colors: the first sentence is full white, the others sit in a soft gray */
	.lead {
		--rest: var(--color-text);
	}

	.soft {
		--rest: color-mix(in srgb, var(--color-text) 75%, var(--color-bg));
	}

	/* Final sentence rests at 65% opacity; hovering it brings it to full */
	.last {
		opacity: 0.65;
	}

	.last:hover {
		opacity: 1;
	}

	/* While any sentence is hovered, dim the others */
	.intro h1:has(.line:hover) .line:not(:hover) {
		opacity: 0.25;
	}

	.contact {
		margin-top: var(--space-8);
	}

	.email {
		font-size: 1rem;
		font-weight: 300;
		letter-spacing: normal;
		color: var(--color-text);
		text-decoration: none;
		transition: color var(--transition);
	}

	.email:hover {
		color: #e09f2f;
	}

	.copy {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-left: var(--space-2);
		padding: var(--space-1);
		font-size: 1rem;
		vertical-align: middle;
		background: none;
		border: 0;
		border-radius: var(--radius);
		color: var(--color-muted);
		cursor: pointer;
		transition: color var(--transition);
	}

	.copy svg {
		width: 1em;
		height: 1em;
	}

	.copy:hover,
	.copy:focus-visible {
		color: var(--color-text);
	}

	.copy.copied {
		color: #e09f2f;
	}
</style>

<script>
	// Sweep at a constant speed: a sentence's duration is its total rendered width (all wrapped lines) divided by the speed
	const SWEEP_SPEED = 2000; // px per second
	const lines = document.querySelectorAll<HTMLElement>('.line');

	function setSweepDurations() {
		lines.forEach((line) => {
			const width = [...line.getClientRects()].reduce((sum, rect) => sum + rect.width, 0);
			line.style.setProperty('--sweep', `${(width / SWEEP_SPEED).toFixed(3)}s`);
		});
	}

	setSweepDurations();
	document.fonts.ready.then(setSweepDurations);
	const headline = document.querySelector('h1');
	if (headline) new ResizeObserver(setSweepDurations).observe(headline);

	const button = document.querySelector<HTMLButtonElement>('.copy');

	button?.addEventListener('click', async () => {
		await navigator.clipboard.writeText(button.dataset.email ?? '');
		button.classList.add('copied');
		setTimeout(() => button.classList.remove('copied'), 1500);
	});
</script>
