---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout>
	<section class="intro container" id="about">
		<p class="tagline"><span class="tagline-text"><span class="tagline-word" style="--w:0">Design</span> <span class="tagline-word" style="--w:1">for</span> <span class="tagline-word tagline-accent" style="--w:2">impact</span></span></p>
		<h1><span class="line">I am an Experience Design Architect, AI builder, and team leader. </span><span class="line">I transform complex systems into intuitive, human-centered experiences. </span><span class="line">My focus is to scale and mentor high-velocity teams that ship the right work.</span></h1>
		<!-- Headline reveal: runs right after the h1 so it is hidden before first paint, then each wrapped line drops in and fades in one after another.
		     Words are wrapped temporarily so each one's line can be measured (same idea as the subpages in BaseLayout), then the original markup is restored. -->
		<script is:inline>
			(() => {
				const h1 = document.currentScript.previousElementSibling;
				if (!h1 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				const START = 900 + 300; // the tagline (two 150ms word staggers + a 600ms fade), plus a 300ms pause before the headline starts
				const STAGGER = 80;
				const DURATION = 600; // long enough that the fade reads as a fade
				const GAP = 300; // pause after the headline, and again after the next heading
				const root = document.documentElement;
				h1.style.opacity = '0';
				// Hides the first section below until the headline has finished (see .intro-anim in the styles)
				root.classList.add('intro-anim', 'reveal-anim');
				const run = () => {
					const lines = [...h1.querySelectorAll('.line')];
					const originals = lines.map((line) => [...line.childNodes].map((n) => n.cloneNode(true)));
					const words = [];
					for (const line of lines) {
						const text = line.firstChild;
						const fragment = document.createDocumentFragment();
						for (const part of text.data.split(/(\s+)/)) {
							if (!part) continue;
							if (!part.trim()) {
								fragment.append(part);
								continue;
							}
							const word = document.createElement('span');
							word.textContent = part;
							// The sentence's text is painted by its own background gradient (transparent fill), which a child's
							// opacity can't affect. So for the reveal each word paints itself in the resting color instead.
							word.style.webkitTextFillColor = 'var(--rest)';
							fragment.append(word);
							words.push(word);
						}
						line.style.backgroundImage = 'none';
						line.replaceChildren(fragment);
					}
					// Number the visual lines by each word's position, top to bottom
					let row = -1;
					let rowTop = -Infinity;
					const timings = words.map((word) => {
						const top = word.getBoundingClientRect().top;
						if (top - rowTop > 4) {
							row++;
							rowTop = top;
						}
						return row;
					});
					h1.style.opacity = '';
					words.forEach((word, i) => {
						word.animate(
							[{ opacity: 0 }, { opacity: 1 }],
							{ duration: DURATION, delay: START + timings[i] * STAGGER, easing: 'ease-out', fill: 'backwards' },
						);
					});
					// Then the first section: its heading after a pause, and its cards after another
					const headlineEnd = START + row * STAGGER + DURATION;
					const next = document.querySelector('.intro + .snapshot');
					const drop = (el, delay) => {
						el.animate(
							[{ opacity: 0, transform: 'translateY(-1.25rem)' }, { opacity: 1, transform: 'none' }],
							{ duration: DURATION, delay, easing: 'ease-out', fill: 'backwards' },
						);
					};
					const headingDelay = headlineEnd + GAP;
					// Every section uses this same sequence: the heading, a pause, then the cards one after another
					const revealSection = (section, delay) => {
						const heading = section.querySelector('h2');
						const cards = section.querySelectorAll('.snapshot-card');
						if (heading) drop(heading, delay);
						cards.forEach((card, i) => drop(card, delay + GAP + i * STAGGER));
						section.classList.add('revealed');
					};
					let firstEnd = 0;
					if (next) {
						revealSection(next, headingDelay);
						firstEnd = performance.now() + headingDelay + GAP + (next.querySelectorAll('.snapshot-card').length - 1) * STAGGER + DURATION;
					}
					// The sections below reveal the same way as they scroll into view (waiting for the first section if they are already visible)
					const later = document.querySelectorAll('.intro + .snapshot ~ .snapshot');
					const observer = new IntersectionObserver((entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							observer.unobserve(entry.target);
							const wait = firstEnd - performance.now();
							revealSection(entry.target, wait > 0 ? wait + GAP : 0);
						}
					}, { rootMargin: '0px 0px -10% 0px' });
					later.forEach((section) => observer.observe(section));
					root.classList.remove('intro-anim');
					setTimeout(() => lines.forEach((line, i) => {
						line.replaceChildren(...originals[i]);
						line.style.backgroundImage = '';
					}), START + row * STAGGER + DURATION + 100);
				};
				document.fonts.ready.then(run);
			})();
		</script>
	</section>
	<section class="snapshot container" aria-labelledby="passions-title">
		<h2 id="passions-title">What I'm Most Passionate About</h2>
		<ul class="snapshot-grid cols-3 linked-cards">
			<li class="snapshot-card">
				<a class="card-link" href={`${base}/approach/`}>
					<div class="card-image" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></svg>
					</div>
					<div class="card-body">
						<p class="stat stat-title"><span class="sweep">Solving complexity through design craft</span></p>
						<p class="sub-copy"><span class="link-sweep">My approach to design</span></p>
					</div>
				</a>
			</li>
			<li class="snapshot-card">
				<a class="card-link" href={`${base}/work/`}>
					<div class="card-image" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></svg>
					</div>
					<div class="card-body">
						<p class="stat stat-title"><span class="sweep">Building excellent products</span></p>
						<p class="sub-copy"><span class="link-sweep">See my latest work</span></p>
					</div>
				</a>
			</li>
			<li class="snapshot-card">
				<a class="card-link" href={`${base}/teaching/`}>
					<div class="card-image" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></svg>
					</div>
					<div class="card-body">
						<p class="stat stat-title"><span class="sweep">Helping teams and individuals level-up</span></p>
						<p class="sub-copy"><span class="link-sweep">Shaping design culture</span></p>
					</div>
				</a>
			</li>
		</ul>
	</section>
	<section class="snapshot container" aria-labelledby="expertise-title">
		<h2 id="expertise-title">Design Expertise</h2>
		<ul class="snapshot-grid cols-3 expertise">
			<li class="snapshot-card">
				<div class="flip" role="button" tabindex="0" aria-pressed="false">
					<div class="flip-inner">
						<div class="face front">
							<span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 5-9 5-9-5 9-5Z" /><path d="m3 13 9 5 9-5" /></svg></span>
							<p class="stat stat-title">Enterprise Systems &amp; Platform Architecture</p>
							<p class="flip-hint sub-copy">Flip for more</p>
						</div>
						<div class="face back">
							<p class="label">Moving beyond single-screen usability to design cohesive, multi-product ecosystems. Contemporary design leaders must untangle deep technical complexity, establish scalable governance, and architect foundational patterns that allow entire organizations to build consistently.</p>
						</div>
					</div>
				</div>
			</li>
			<li class="snapshot-card">
				<div class="flip" role="button" tabindex="0" aria-pressed="false">
					<div class="flip-inner">
						<div class="face front">
							<span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m8 7-5 5 5 5" /><path d="m16 7 5 5-5 5" /><path d="m14 4-4 16" /></svg></span>
							<p class="stat stat-title">AI-Native Workflows &amp; Code Prototyping</p>
							<p class="flip-hint sub-copy">Flip for more</p>
						</div>
						<div class="face back">
							<p class="label">Closing the gap between design intent and production reality. Modern leaders do not just oversee static design files; they leverage AI tools to prototype directly in code, validate technical constraints early, and fundamentally accelerate how their teams align and ship.</p>
						</div>
					</div>
				</div>
			</li>
			<li class="snapshot-card">
				<div class="flip" role="button" tabindex="0" aria-pressed="false">
					<div class="flip-inner">
						<div class="face front">
							<span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2" /><circle cx="5" cy="19" r="2" /><circle cx="19" cy="19" r="2" /><path d="M12 7v4m0 0-6 6m6-6 6 6" /></svg></span>
							<p class="stat stat-title">Cross-Functional Orchestration &amp; Team Scaling</p>
							<p class="flip-hint sub-copy">Flip for more</p>
						</div>
						<div class="face back">
							<p class="label">Designing the operational environment as intentionally as the product itself. This requires aligning Product, Engineering, and Architecture triads to eliminate corporate silos, while simultaneously mentoring emerging talent and cultivating a high-velocity, resilient design culture.</p>
						</div>
					</div>
				</div>
			</li>
			<li class="snapshot-card">
				<div class="flip" role="button" tabindex="0" aria-pressed="false">
					<div class="flip-inner">
						<div class="face front">
							<span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 17 6-6 4 4 8-8" /><path d="M15 7h6v6" /></svg></span>
							<p class="stat stat-title">Commercial Strategy &amp; Value Realization</p>
							<p class="flip-hint sub-copy">Flip for more</p>
						</div>
						<div class="face back">
							<p class="label">Speaking the language of the executive suite. Design leadership today requires tying every architectural decision directly to market differentiation, product strategy, and measurable business ROI, rather than treating user empathy in isolation.</p>
						</div>
					</div>
				</div>
			</li>
			<li class="snapshot-card">
				<div class="flip" role="button" tabindex="0" aria-pressed="false">
					<div class="flip-inner">
						<div class="face front">
							<span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg></span>
							<p class="stat stat-title">Foundational Craft &amp; Design Rigor</p>
							<p class="flip-hint sub-copy">Flip for more</p>
						</div>
						<div class="face back">
							<p class="label">Setting an uncompromising bar for usability, accessibility, and visual clarity. Even as AI accelerates how quickly teams ship, contemporary leaders anchor their organizations in core human-centered principles, ensuring every interaction remains intuitive, intentional, and built to last.</p>
						</div>
					</div>
				</div>
			</li>
			<li class="snapshot-card">
				<div class="flip" role="button" tabindex="0" aria-pressed="false">
					<div class="flip-inner">
						<div class="face front">
							<span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg></span>
							<p class="stat stat-title">Rapid Research &amp; Continuous Validation</p>
							<p class="flip-hint sub-copy">Flip for more</p>
						</div>
						<div class="face back">
							<p class="label">Replacing slow, siloed research cycles with high-velocity discovery. By embedding lightweight testing and continuous user feedback directly into the build process, leaders pressure-test assumptions early, de-risk product bets, and keep teams tightly aligned with validated human needs.</p>
						</div>
					</div>
				</div>
			</li>
		</ul>
	</section>
	<section class="snapshot container" aria-labelledby="snapshot-title">
		<h2 id="snapshot-title">Leadership &amp; Impact Snapshot</h2>
		<ul class="snapshot-grid linked-cards">
			<li class="snapshot-card">
				<a class="card-link" href={`${base}/work/`}>
					<div class="card-body">
						<p class="stat"><span class="sweep">$93M</span></p>
						<p class="label">Revenue lift from rapidly scaling Best Buy's pickup experience during COVID-19.</p>
						<p class="cta sub-copy"><span class="link-sweep">See case study</span></p>
					</div>
				</a>
			</li>
			<li class="snapshot-card">
				<a class="card-link" href={`${base}/work/`}>
					<div class="card-body">
						<p class="stat"><span class="sweep">+100K</span></p>
						<p class="label">New creators onboarded through a cloud-connected overhaul of the Unity Hub platform.</p>
						<p class="cta sub-copy"><span class="link-sweep">See case study</span></p>
					</div>
				</a>
			</li>
			<li class="snapshot-card">
				<a class="card-link" href={`${base}/work/`}>
					<div class="card-body">
						<p class="stat"><span class="sweep">+52%</span></p>
						<p class="label">Customer conversion lift from connecting online shoppers directly with in-store product experts.</p>
						<p class="cta sub-copy"><span class="link-sweep">See case study</span></p>
					</div>
				</a>
			</li>
			<li class="snapshot-card">
				<a class="card-link" href={`${base}/work/`}>
					<div class="card-body">
						<p class="stat"><span class="sweep">+270%</span></p>
						<p class="label">Surge in review platform engagement after rebuilding BestBuy.ca's customer-voice ecosystem.</p>
						<p class="cta sub-copy"><span class="link-sweep">See case study</span></p>
					</div>
				</a>
			</li>
		</ul>
	</section>
	<section class="snapshot container" aria-labelledby="kind-words-title">
		<h2 id="kind-words-title">Some great people with kind words</h2>
		<ul class="snapshot-grid cols-3">
			<li class="snapshot-card">
				<figure class="quote">
					<blockquote>
						<p>Rob unites teams, drives action, and truly listens. He bridges silos, communicates with clarity, purpose and earns trust at every level. Resilient and adaptable, he delivers while others deliberate. We survived the largest tech firms together—he never breaks, only bends and leads.</p>
					</blockquote>
					<figcaption class="sub-copy">
						<span class="name">Shawn Mcclelland</span>
						<span class="role">Head of Design Platform @ Intuit</span>
					</figcaption>
				</figure>
			</li>
			<li class="snapshot-card">
				<figure class="quote">
					<blockquote>
						<p>As a design leader, Rob has an impressive ability to bring people into the design process through transparency and inspiration. He operates with a philosophy that the more people understand the design process and principles, the better the team's output and the results they achieve.</p>
					</blockquote>
					<figcaption class="sub-copy">
						<span class="name">Mark Raham</span>
						<span class="role">Executive Producer @ Kabam</span>
					</figcaption>
				</figure>
			</li>
			<li class="snapshot-card">
				<figure class="quote">
					<blockquote>
						<p>Rob continuously impresses with his drive to pull multiple disciplines together, understand their needs, and reflect those in his solutions. He is a strong communicator—across, up, and down—and leans on his strong empathy for both end-users and stakeholders that guides his process.</p>
					</blockquote>
					<figcaption class="sub-copy">
						<span class="name">Jose Zamudio-Meyer</span>
						<span class="role">Creative Director @ Discord</span>
					</figcaption>
				</figure>
			</li>
		</ul>
	</section>
</BaseLayout>

<script>
	// Scale the tagline's font size so its text exactly fills the content width.
	const tagline = document.querySelector<HTMLElement>('.tagline');
	const text = tagline?.querySelector<HTMLElement>('.tagline-text');
	function fitTagline() {
		if (!tagline || !text) return;
		tagline.style.fontSize = '100px';
		const available = tagline.clientWidth;
		const natural = text.getBoundingClientRect().width;
		if (available && natural) tagline.style.fontSize = `${(100 * available) / natural}px`;
	}
	fitTagline();
	document.fonts?.ready.then(fitTagline);
	window.addEventListener('resize', fitTagline);
</script>

<style>
	/* Full container width so the headline and email share the header and footer's left edge;
	   the line length is limited on the h1 instead of narrowing (and so re-centering) the container. */
	.intro {
		padding-top: calc(var(--space-section) * 0.75);
		padding-bottom: var(--space-section);
	}

	/* Large all-caps tagline between the page title and the headline, in a fixed dark gray */
	.tagline {
		margin: 0 0 calc(var(--space-12) * 1.25 * 1.15);
		/* Sized by the script below so the text spans the full content width; this is the fallback */
		font-size: 9.5cqw;
		font-weight: 700;
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		text-transform: uppercase;
		white-space: nowrap;
		color: #1a1a1a;
	}

	/* Dark mode: light gray, shared with the headline lines below */
	:global(:root[data-theme='dark']) .tagline {
		color: #c8c8c8;
	}

	.tagline-text {
		display: inline-block;
	}

	/* On load, the elements in view drop in from above while fading in, one after another.
	   --i is each element's place in the order; the delay is --i times the stagger. */
	@keyframes drop-in {
		from {
			opacity: 0;
			transform: translateY(-1.25rem);
		}
	}

	/* The headline's lines are animated by the script after the h1, between the tagline and this heading */
	/* Each word of the tagline drops in a beat after the one before (keep 150ms in sync with START in the script after the h1) */
	.tagline-word {
		display: inline-block;
		animation: drop-in 600ms ease-out backwards;
		animation-delay: calc(var(--w) * 150ms);
	}

	/* The first section below the headline is held back by the script after the h1, which animates it in and then removes this class */
	:global(.intro-anim) .intro + .snapshot :is(h2, .snapshot-card) {
		opacity: 0;
	}

	/* The sections further down stay hidden until the script reveals them as they scroll into view */
	:global(.reveal-anim) .intro + .snapshot ~ .snapshot:not(.revealed) :is(h2, .snapshot-card) {
		opacity: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.tagline-word {
			animation: none;
		}
	}

	/* "Impact" uses the same orange as the hover sweep */
	.tagline-accent {
		color: var(--color-primary);
	}

	.intro {
		container-type: inline-size;
	}

	.intro h1 {
		width: 100%;
		max-width: none;
		margin-block: 0 var(--space-6);
		font-size: 3rem;
	}

	/* Each sentence's own text is painted from a two-tone gradient: amber on the left, its resting color on the right.
	   Sliding the gradient recolors the existing text left to right on hover and back on mouse-off.
	   The sweep has a gentle ease-in-out, and --sweep (set per sentence by the script below) scales its duration to the sentence length so every sentence moves at the same speed. */
	.line {
		/* Every sentence rests in the same soft gray */
		--rest: color-mix(in srgb, var(--color-text) 75%, var(--color-bg));
		background-image: linear-gradient(to right, var(--color-primary) 50%, var(--rest) 50%);
		background-size: 200% 100%;
		background-position: 100% 0;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
		transition: background-position var(--sweep, 0.4s) cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
	}

	/* Light mode: rest in the same dark gray as the tagline */
	:global(:root:not([data-theme='dark'])) .line {
		--rest: #1a1a1a;
	}

	/* Dark mode: rest in the same light gray as the tagline */
	:global(:root[data-theme='dark']) .line {
		--rest: #c8c8c8;
	}

	.line:hover {
		background-position: 0 0;
	}

	/* While any sentence is hovered, dim the others */
	.intro h1:has(.line:hover) .line:not(:hover) {
		opacity: 0.25;
	}

	.snapshot {
		padding-bottom: var(--space-section);
	}

	.snapshot h2 {
		margin-block: 0 var(--space-6);
		font-size: var(--text-heading);
	}

	.snapshot-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.snapshot-grid.cols-3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.snapshot-card {
		padding: var(--space-6);
		background: var(--color-surface);
		border-radius: var(--radius);
	}

	/* Linked cards (the passion cards and the Leadership & Impact cards) link to other pages. On hover or keyboard focus the card floats up
	   and glows softly, its large text sweeps to amber, and its link text gets the header-link treatment. */
	.linked-cards .snapshot-card {
		padding: 0;
		transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
	}

	/* The link fills the whole card so the entire card is clickable; the image runs edge to edge and the text sits in .card-body */
	.linked-cards .card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		border-radius: inherit;
		color: inherit;
		text-decoration: none;
	}

	/* Fills the card below the image so a link at the bottom lines up across a row */
	.linked-cards .card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 0 var(--space-6) var(--space-6);
	}

	/* Cards without an image start with the same padding on top as on the sides */
	.linked-cards .card-body:first-child {
		padding-top: var(--space-6);
	}

	/* "See case study": the header-link effect, pinned to the bottom left of the card. Type styling comes from .sub-copy. */
	.linked-cards .cta {
		margin: auto 0 0;
		padding-top: var(--space-4);
	}

	/* Edge to edge at the top of the card, with its top corners following the card's rounded corners */
	.linked-cards .card-image {
		flex: none;
		border-radius: var(--radius) var(--radius) 0 0;
	}

