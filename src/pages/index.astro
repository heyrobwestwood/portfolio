	   its hit area would shrink to a sliver mid-turn, so clicks would miss and the hover glow would flicker. */
	.expertise .snapshot-card {
		padding: 0;
		background: none;
		border: 0;
	}

	.expertise .flip {
		display: grid;
		height: 100%;
		border-radius: var(--radius);
		perspective: 1200px;
		cursor: pointer;
		/* A quick double-click shouldn't select the text, and a tap shouldn't flash the browser's highlight */
		user-select: none;
		-webkit-user-select: none;
		-webkit-tap-highlight-color: transparent;
	}

	.expertise .flip-inner {
		display: grid;
		transform-style: preserve-3d;
		transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
		will-change: transform;
	}

	.expertise .flip.is-flipped .flip-inner {
		transform: rotateY(180deg);
	}

	.expertise .face {
		grid-area: 1 / 1;
		padding: var(--space-6);
		background: var(--color-surface);
		border-radius: var(--radius);
		-webkit-backface-visibility: hidden;
		backface-visibility: hidden;
		transition: box-shadow 0.2s ease-out;
	}

	.expertise .back {
