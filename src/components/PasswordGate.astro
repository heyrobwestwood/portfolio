---
// Encrypts its slot content at build time (AES-256-GCM, key derived from the password with PBKDF2),
// so the built HTML contains only ciphertext. The browser decrypts it with the Web Crypto API.
// The password is read from the PROJECT_PASSWORD environment variable (.env locally, a repository secret in CI)
// so it never appears in the source code or the built site.

// True during `astro dev`, false in `astro build`, so the gate only appears on the built site
const isDev = import.meta.env.DEV;

const ITERATIONS = 600_000;

const toBase64 = (bytes: ArrayBuffer | Uint8Array) => Buffer.from(bytes as ArrayBuffer).toString('base64');

let payload: { ciphertext: string; salt: string; iv: string } | undefined;

if (!isDev) {
	const password = import.meta.env.PROJECT_PASSWORD ?? process.env.PROJECT_PASSWORD;
	if (!password) {
		throw new Error('PasswordGate: set the PROJECT_PASSWORD environment variable to build protected pages.');
	}

	const html = await Astro.slots.render('default');
	const salt = crypto.getRandomValues(new Uint8Array(16));
	const iv = crypto.getRandomValues(new Uint8Array(12));

	const baseKey = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
	const key = await crypto.subtle.deriveKey(
		{ name: 'PBKDF2', salt, iterations: ITERATIONS, hash: 'SHA-256' },
		baseKey,
		{ name: 'AES-GCM', length: 256 },
		false,
		['encrypt'],
	);
	const ciphertext = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, new TextEncoder().encode(html));

	payload = { ciphertext: toBase64(ciphertext), salt: toBase64(salt), iv: toBase64(iv) };
}
---

{isDev ? (
	<>
		{/* Marker that shows the "gate bypassed" notice in the header (see Header.astro) */}
		<span data-password-gate hidden></span>
		<slot />
	</>
) : (
	<>
		<div id="password-screen" class="container">
			<form id="gate-form">
				<h2>Protected project</h2>
				<label class="visually-hidden" for="gate-input">Password</label>
				<input type="password" id="gate-input" placeholder="Enter password…" autocomplete="current-password" required />
				<button type="submit">Unlock</button>
				<p id="gate-error" class="error" role="alert" hidden>Incorrect password</p>
			</form>
		</div>

		{/* Runs before paint: if the password was already entered this session, hide the form so it doesn't flash
		    while the page unlocks itself. The key must match SESSION_KEY in the script below. */}
		<script is:inline>
			try {
				if (sessionStorage.getItem('password-gate')) document.getElementById('password-screen').hidden = true;
			} catch {}
		</script>

		<div
			id="protected-content"
			hidden
			data-ciphertext={payload!.ciphertext}
			data-salt={payload!.salt}
			data-iv={payload!.iv}
			data-iterations={ITERATIONS}
		/>
	</>
)}

<script>
	const form = document.querySelector<HTMLFormElement>('#gate-form');
	const input = document.querySelector<HTMLInputElement>('#gate-input');
	const error = document.querySelector<HTMLElement>('#gate-error');
	const content = document.querySelector<HTMLElement>('#protected-content');

	const fromBase64 = (value: string) => Uint8Array.from(atob(value), (char) => char.charCodeAt(0));

	async function decrypt(password: string, data: DOMStringMap) {
		const baseKey = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
		const key = await crypto.subtle.deriveKey(
			{ name: 'PBKDF2', salt: fromBase64(data.salt!), iterations: Number(data.iterations), hash: 'SHA-256' },
			baseKey,
			{ name: 'AES-GCM', length: 256 },
			false,
			['decrypt'],
		);
		// Throws if the password is wrong, since AES-GCM authenticates the ciphertext
		const plaintext = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: fromBase64(data.iv!) }, key, fromBase64(data.ciphertext!));
		return new TextDecoder().decode(plaintext);
	}

	// The password is remembered in sessionStorage, which lasts until the browser tab is closed,
	// so it only has to be entered once per visit. The key must match the inline script above.
	const SESSION_KEY = 'password-gate';

	const session = {
		get: () => {
			try {
				return sessionStorage.getItem(SESSION_KEY);
			} catch {
				return null;
			}
		},
		set: (value: string) => {
			try {
				sessionStorage.setItem(SESSION_KEY, value);
			} catch {}
		},
		clear: () => {
			try {
				sessionStorage.removeItem(SESSION_KEY);
			} catch {}
		},
	};

	async function unlock(password: string) {
		content!.innerHTML = await decrypt(password, content!.dataset);
		content!.hidden = false;
		document.querySelector('#password-screen')?.remove();
	}

	// Unlock straight away with the remembered password. If it no longer works (e.g. the password changed), forget it and show the form.
	const saved = session.get();
	if (saved && content) {
		unlock(saved).catch(() => {
			session.clear();
			const screen = document.querySelector<HTMLElement>('#password-screen');
			if (screen) screen.hidden = false;
		});
	}

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!input || !error || !content) return;

		const button = form.querySelector('button')!;
		button.disabled = true;
		button.textContent = 'Unlocking…';
		error.hidden = true;

		try {
			await unlock(input.value);
			session.set(input.value);
		} catch {
			error.hidden = false;
			input.select();
			button.disabled = false;
			button.textContent = 'Unlock';
		}
	});
</script>

<style>
	/* No top padding: the page title above the gate sets the top spacing */
	#password-screen {
		padding-bottom: var(--space-section);
	}

	form {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		max-width: 28rem;
	}

	h2 {
		flex-basis: 100%;
		margin-bottom: var(--space-2);
		font-size: var(--text-xl);
		font-weight: 300;
	}

	input {
		flex: 1;
		padding: var(--space-2) var(--space-3);
		font: inherit;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	input:focus-visible {
		outline: 2px solid var(--color-key);
		outline-offset: 1px;
	}

	button {
		padding: var(--space-2) var(--space-4);
		font: inherit;
		color: var(--color-bg);
		background: var(--color-text);
		border: 0;
		border-radius: var(--radius);
		cursor: pointer;
		transition: background var(--transition);
	}

	button:hover,
	button:focus-visible {
		background: var(--color-key);
		color: #171717;
	}

	button:disabled {
		cursor: progress;
		opacity: 0.7;
	}

	.error {
		flex-basis: 100%;
		font-size: var(--text-sm);
		color: var(--color-key);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
