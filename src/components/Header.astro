---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
	{ label: 'Approach', href: `${base}/approach/` },
	{ label: 'Work', href: `${base}/work/` },
	{ label: 'Teaching', href: `${base}/teaching/` },
	{ label: 'Credentials', href: `${base}/credentials/` },
	{ label: 'About', href: `${base}/about/` },
];

// Normalized to a trailing slash so it matches the hrefs above whether or not the URL has one
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="site-header">
	<div class="container inner">
		<a class="wordmark hover-sweep" href={`${base}/`}>Robert Westwood</a>
		<span class="divider" aria-hidden="true">|</span>
		<nav aria-label="Primary">
			<ul>
				{links.map(({ label, href }) => (
					<li>
						{currentPath === href ? (
							<span class="current" aria-current="page">{label}</span>
						) : (
							<a class="hover-sweep" href={href}>{label}</a>
						)}
					</li>
				))}
			</ul>
		</nav>
		{import.meta.env.DEV && <p class="gate-notice">🔒 Password gate bypassed (local dev mode)</p>}
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--color-bg) 85%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--color-border);
	}

	.inner {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		min-height: var(--space-16);
	}

	.wordmark {
		font-size: 1rem;
		font-weight: 300;
		letter-spacing: 0.02em;
	}

	.divider {
		color: var(--color-muted);
		font-weight: 300;
	}

	ul {
		display: flex;
		gap: var(--space-6);
		padding: 0;
		list-style: none;
	}

	nav a,
	.current {
		font-size: 1rem;
		font-weight: 300;
		letter-spacing: normal;
		--rest: var(--color-muted);
	}

	/* The current page's item is plain text, not a link, in the full text color */
	.current {
		color: var(--color-text);
	}

	/* Dev only: shown on pages that contain a PasswordGate, which renders the marker in dev mode */
	.gate-notice {
		display: none;
		margin-left: auto;
		padding: var(--space-1) var(--space-3);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-muted);
		white-space: nowrap;
		border: 1px dashed var(--color-border);
		border-radius: var(--radius);
	}

	:global(body:has([data-password-gate])) .gate-notice {
		display: block;
	}
</style>
